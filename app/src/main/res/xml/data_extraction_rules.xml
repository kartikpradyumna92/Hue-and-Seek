<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="colorwalk.db" />
        <include domain="database" path="colorwalk.db-shm" />
        <include domain="database" path="colorwalk.db-wal" />
        <include domain="file" path="datastore" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="colorwalk.db" />
        <include domain="database" path="colorwalk.db-shm" />
        <include domain="database" path="colorwalk.db-wal" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
