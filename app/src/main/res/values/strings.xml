    <!-- Permission rationale -->
    <string name="perm_camera_title">Camera</string>
    <string name="perm_camera_reason">Captures your daily color walk photo and validates it against today\'s color challenge.</string>
    <string name="perm_location_title">Location</string>
    <string name="perm_location_reason">Tags each photo with where you found the color, building a map of your walks. Skipped automatically if you decline.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_reason">Sends a daily reminder to complete your walk before midnight so you never lose your streak.</string>
    <string name="perm_photos_title">Photo Library</string>
    <string name="perm_photos_reason">Lets you import a photo you already took instead of capturing a new one from the camera.</string>
    <string name="perm_heading">Before we begin</string>
    <string name="perm_intro">Hue &amp; Seek needs a few permissions to give you the full experience. Here\'s exactly what we use each one for.</string>
