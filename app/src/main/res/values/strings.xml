    <!-- Onboarding -->
    <string name="onboarding_1_title">A new color, every day</string>
    <string name="onboarding_1_body">Each day Hue &amp; Seek gives you one color to hunt down in the real world. Step outside and find it.</string>
    <string name="onboarding_2_title">Isolate the color</string>
    <string name="onboarding_2_body">Drag today\'s color into the ring — that\'s the whole game. Out in the world, you\'ll frame it with your camera instead.</string>
    <string name="onboarding_3_title">Capture &amp; validate</string>
    <string name="onboarding_3_body">Take a photo where today\'s color stars in the frame. The app checks automatically — no cheating!</string>
    <string name="onboarding_4_title">Build your streak</string>
    <string name="onboarding_4_body">One photo per day keeps your streak alive. Miss a day and it resets to zero. How far can you go?</string>
    <string name="onboarding_get_started">Get Started</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_caught">That\'s the hunt!</string>

